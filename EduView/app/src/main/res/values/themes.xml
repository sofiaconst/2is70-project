<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EduView" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.EduView" parent="Base.Theme.EduView" />

    <style name="FeedTabTheme" parent="Widget.Design.TabLayout">
        <item name="tabBackground">@drawable/feed_tab_background</item>
        <item name="tabIndicator">@null</item>
        <item name="tabTextAppearance">@style/CustomFeedTabTextAppearance</item>
    </style>

    <style name="CustomFeedTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/lalezar</item>
    </style>

    <style name="TransparentDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>